node_modules/
dist/
.env
.env.local
*.log
/data/          # the runtime SQLite database, at the repo root only
.DS_Store
.vite/

# Stray tsc emit beside sources. The client is bundled by Vite and the server
# emits to server/dist, so a .js next to a .ts/.tsx is always an accident.
client/src/**/*.js
client/vite.config.js
shared/*.js
tools/*.js

# The generated lexicon IS committed: it is the game content, and the
# builder needs the 35MB wordnet-db devDependency that production omits.
!server/src/game/lexicon/data/lexicon.bin
