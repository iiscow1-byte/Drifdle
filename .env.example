# Driftle configuration
#
# Every single variable here is OPTIONAL. With an empty .env the server boots,
# serves the game, and runs the daily puzzle and full multiplayer. Set things
# only to turn on integrations or to pin values you care about.
#
# Copy to `.env` for local development. On Railway, set these as service
# variables instead — the app auto-detects PORT, the public domain, and an
# attached volume with no configuration at all.

# ---------------------------------------------------------------------------
# Core — safe to leave unset
# ---------------------------------------------------------------------------

# Port to listen on. Railway injects this automatically.
# PORT=3000

# Signs session tokens. If unset, one is generated and stored next to the
# database, so sessions still survive restarts. Set it explicitly in production
# if you ever move or rebuild the volume.
# SESSION_SECRET=

# Where the SQLite file lives. Defaults to ./data/driftle.db, or to the
# Railway volume mount when one is attached.
# DATABASE_PATH=./data/driftle.db

# Public base URL, used to build the Discord OAuth redirect. Derived from
# RAILWAY_PUBLIC_DOMAIN automatically when deployed.
# PUBLIC_URL=http://localhost:3000

# Extra browser origins allowed to call the API (comma separated). Only needed
# if you host the client somewhere other than this server.
# CLIENT_ORIGIN=https://driftle.example.com

# Serve the built client from this process. Defaults to true in production,
# false in development (where Vite serves it on :5173).
# SERVE_CLIENT=true

# ---------------------------------------------------------------------------
# Discord — optional. Without these, Discord sign-in, the Activity and Rich
# Presence are cleanly disabled and everything else works as normal.
# ---------------------------------------------------------------------------

# From https://discord.com/developers/applications -> your app -> OAuth2.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------

# MAX_PLAYERS_PER_ROOM=8
# MAX_ROOMS=500
